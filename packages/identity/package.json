{
  "name": "@cocuyo/identity",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "DIM identity integration for F-Network",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cocuyo/network-config": "workspace:*",
    "@cocuyo/types": "workspace:*",
    "@novasamatech/host-api-wrapper": "0.7.9",
    "@polkadot-api/ws-provider": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.1.0"
  }
}
