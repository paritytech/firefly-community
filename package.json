{
  "name": "cocuyo",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "description": "The Firefly Network — Lights in the Dark. A surveillance-resistant network for collective intelligence.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "check": "turbo run lint typecheck test && pnpm format:check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.14",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "comment": "Security overrides for vulnerable transitive deps. Replacement ranges are bounded to the vulnerable major so a patch can't pull in a new major with incompatible engines (e.g. @babel/core 8 requires Node >=22, but engines allows Node 20).",
    "overrides": {
      "protobufjs@<7.5.5": ">=7.6.1 <8",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9",
      "postcss@<8.5.10": ">=8.5.10 <9",
      "esbuild@<0.28.1": ">=0.28.1 <0.29",
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "axios@<1.16.0": ">=1.16.0 <2",
      "undici@<6.24.0": ">=6.24.0 <7",
      "@grpc/grpc-js@<1.14.4": ">=1.14.4 <2",
      "serialize-javascript@<7.0.3": ">=7.0.3 <8",
      "fast-uri@<3.1.2": ">=3.1.2 <4",
      "flatted@<3.4.2": ">=3.4.2 <4",
      "js-cookie@<3.0.7": ">=3.0.7 <4",
      "tmp@<0.2.6": ">=0.2.6 <0.3"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
