# Firefly Network Web App - Environment Variables
# Copy this file to .env.local and fill in the values.
#
# NOTE: apps/web is a Next.js static export (output: 'export'), so every
# NEXT_PUBLIC_* value is baked into the bundle at BUILD time. One built artifact
# targets one network — "switching networks" means rebuild + redeploy.

# ============================================================
# Network Selection
# ============================================================

# Primary network selector. Picks the entry from the @cocuyo/network-config
# registry that supplies the Asset Hub (Substrate WS + EVM RPC), pUSD, Bulletin
# endpoint + IPFS gateway, DIM endpoint, and contract addresses.
#   paseo     — Paseo Next v2 testnet (deploy target)
#   localhost — local hardhat node for EVM contract development
# Unset or unrecognised → localhost.
NEXT_PUBLIC_NETWORK=paseo

# Live chain/Bulletin preset for @polkadot-apps/chain-client. One of:
# polkadot | kusama | paseo. Keep consistent with NEXT_PUBLIC_NETWORK. Inside the
# Triangle host the host decides the actual network and routes the connection;
# this value only takes effect for standalone `pnpm dev`.
NEXT_PUBLIC_CHAIN_ENVIRONMENT=paseo

# Use blockchain-backed services (true) or session-cached/seed services (false).
NEXT_PUBLIC_USE_CHAIN=false

# ============================================================
# Advanced — per-field overrides (optional)
# ============================================================
# Each overrides the corresponding field from the selected network registry
# entry. Leave blank to use the registry value (recommended). Listed values are
# the registry defaults for `paseo` (Paseo Next v2), shown for reference.

# Asset Hub RPC. Routed by protocol: a wss:// value overrides the Substrate WS
# endpoint; an https:// value overrides the EVM JSON-RPC endpoint.
#   substrate default: wss://paseo-asset-hub-next-rpc.polkadot.io
#   evm default:       https://eth-rpc-paseo-next.polkadot.io
NEXT_PUBLIC_ASSET_HUB_RPC=

# Additional Substrate WS fallbacks (comma-separated).
NEXT_PUBLIC_ASSET_HUB_FALLBACK_RPCS=

# EVM chain id (registry default for paseo: 420420417).
NEXT_PUBLIC_CHAIN_ID=

# pUSD (dotUSD) token address (registry default: 0xFbBd09cF4a6d1F160473537FB8A4Fc502ED49FB2).
NEXT_PUBLIC_PUSD_ASSET_ADDRESS=

# Bulletin Chain endpoint (registry default: wss://paseo-bulletin-next-rpc.polkadot.io).
NEXT_PUBLIC_BULLETIN_ENDPOINT=

# IPFS gateway (registry default: https://paseo-bulletin-next-ipfs.polkadot.io/ipfs/).
NEXT_PUBLIC_IPFS_GATEWAY=

# ============================================================
# Smart Contract Addresses (set after deployment)
# ============================================================
# Override the registry's per-network contract addresses. Leave blank to use the
# registry value (BountyEscrow / FireflyReputation are pinned per network there;
# the four below have no committed default yet).

# CrowdstackingPool contract address
NEXT_PUBLIC_CROWDSTACKING_POOL_ADDRESS=

# AllianceGovernance contract address
NEXT_PUBLIC_ALLIANCE_GOVERNANCE_ADDRESS=

# OutletRegistry contract address
NEXT_PUBLIC_OUTLET_REGISTRY_ADDRESS=

# ContributorRegistry contract address
NEXT_PUBLIC_CONTRIBUTOR_REGISTRY_ADDRESS=

# ============================================================
# Feature Flags
# ============================================================

# Use mock payment service for development (true) or real chain (false)
NEXT_PUBLIC_USE_MOCK_PAYMENT=true

# Use on-chain contracts (true) or session-cached services (false)
NEXT_PUBLIC_USE_CHAIN_CONTRACTS=false

# Recipient (SS58) for real on-chain native-PAS payments, e.g. bounty funding.
# Required to activate real payments: with NEXT_PUBLIC_USE_MOCK_PAYMENT=false the
# payment service submits a genuine Balances.transfer_keep_alive to this address.
# Leave unset to keep payments simulated (the default). No default — set your own
# treasury/escrow address.
NEXT_PUBLIC_PAYMENT_RECIPIENT=

# ============================================================
# pUSD Payment Service (Legacy - Phase 10)
# ============================================================

# Triangle SDK API key for pUSD payments (legacy)
# Obtain from: https://novasama.tech/triangle
NEXT_PUBLIC_PUSD_API_KEY=

# Payment environment: 'testnet' or 'production'
NEXT_PUBLIC_PUSD_ENV=testnet

# ============================================================
# AI Claim Extraction (Bring Your Own AI)
# ============================================================

# Endpoint for claim extraction. There is NO default — the network ships no
# shared/credentialed AI backend. Point this at your own service (e.g. a
# Cloudflare Worker holding your own OpenAI/Anthropic key). Leave unset to
# disable claim extraction. See apps/web/src/lib/ai/README.md for setup.
NEXT_PUBLIC_CLAIM_EXTRACTOR_URL=
