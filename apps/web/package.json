{
  "name": "@cocuyo/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "dev": "next dev",
    "postinstall": "papi generate",
    "prebuild": "node scripts/check-network.cjs",
    "build": "next build && cp dist/en/index.html dist/index.html",
    "start": "next start",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "clean": "rm -rf .next dist out coverage",
    "serve": "npx serve dist",
    "deploy": "dotns bulletin upload ./dist --parallel --print-contenthash"
  },
  "dependencies": {
    "@cocuyo/bulletin": "workspace:*",
    "@cocuyo/identity": "workspace:*",
    "@cocuyo/individuality": "workspace:*",
    "@cocuyo/network-config": "workspace:*",
    "@cocuyo/types": "workspace:*",
    "@cocuyo/ui": "workspace:*",
    "@noble/hashes": "^1.7.2",
    "@novasamatech/host-api-wrapper": "0.7.9",
    "@parity/product-sdk-cloud-storage": "0.5.5",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-apps/address": "0.4.0",
    "@polkadot-apps/chain-client": "^2.0.6",
    "ethers": "^6.10.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "next-intl": "^4.9.2",
    "polkadot-api": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.27.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.1.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.0"
  }
}
